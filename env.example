# Copy this file to .env and replace every value. Never commit .env.

# MongoDB root user (used by docker compose and by the app)
MONGO_USER=admin
MONGO_PASSWORD=change-me

# JWT signing key: generate with `openssl rand -base64 32`
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32

# Admin account created on first start (password: 8 to 72 characters)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Password of keystore.p12 (at least 6 characters)
KEYSTORE_PASSWORD=change-me
